        "cut": {
          "label": "切法",
          "options": [
            {
              "id": "yx_cut_1",
              "name": "切细丝(3mm宽)",
              "desc": "250g切约200根，经典做法",
              "score": 10,
              "detail": "3mm宽的肉丝是鱼香肉丝的经典。先切2mm厚片，再切3mm宽丝。顺着纹理切更有嚼劲。"
            },
            {
              "id": "yx_cut_2",
              "name": "切粗丝(5mm宽)",
              "desc": "250g切约120根，口感更有嚼劲",
              "score": 7,
              "detail": "5mm粗丝口感更好，但炒的时间要加长30秒。"
            },
            {
              "id": "yx_cut_3",
              "name": "切薄片",
              "desc": "快速入味，但不够经典",
              "score": 6,
              "detail": "切片受热快，1分钟就能熟。但鱼香肉丝的经典是肉丝。"
            }
          ]
        }
      }
    },
    "vegetable": {
      "name": "配菜",
      "icon": "🥕",
      "amount": "木耳50g+胡萝卜半根(50g)+青椒1个(80g)",
      "options": {
        "type": {
          "label": "配菜选择",
          "options": [
            {
              "id": "yx_v1",
              "name": "木耳50g+胡萝卜50g+青椒80g",
              "desc": "经典三丝搭配",
              "score": 10,
              "detail": "木耳泡发后切丝50g，胡萝卜切丝50g，青椒切丝80g。三种配菜颜色搭配好看，口感丰富。"
            },
            {
              "id": "yx_v2",
              "name": "笋丝100g+木耳50g",
              "desc": "清爽口感",
              "score": 8,
              "detail": "笋丝100g+木耳50g。笋丝脆嫩，木耳爽滑。没有青椒那么辣。"
            },
            {
              "id": "yx_v3",
              "name": "只用胡萝卜100g",
              "desc": "简单家常",
              "score": 6,
              "detail": "只用胡萝卜100g切丝。简单方便，但缺少层次感。"
            }
          ]
        }
      }
    }
  },
