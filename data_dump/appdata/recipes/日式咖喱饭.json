{
  "dish": "日式咖喱饭",
  "cuisine": "日料",
  "category": "japanese",
  "difficulty": 2,
  "cook_time": 35,
  "servings": "3-4人份",
  "calories": "约550大卡\/份",
  "ingredients": {
    "chicken": {
      "name": "鸡腿肉",
      "icon": "🍗",
      "amount": "300g鸡腿肉（约2个鸡腿）",
      "options": {
        "cut": {
          "label": "切法",
          "options": [
            {
              "id": "jkc_1",
              "name": "切3cm块",
              "desc": "300g约15块，标准大小",
              "score": 10,
              "detail": "3cm鸡腿块是咖喱的经典大小，受热均匀，炖煮后口感饱满。鸡腿肉比鸡胸肉更嫩滑多汁。"
            },
            {
              "id": "jkc_2",
              "name": "切5cm大块",
              "desc": "300g约10块，口感饱满",
              "score": 7,
              "detail": "5cm大块炖煮时间要加长5分钟，但肉感十足。"
            },
            {
              "id": "jkc_3",
              "name": "用鸡腿肉去骨",
              "desc": "更嫩滑多汁",
              "score": 9,
              "detail": "去骨鸡腿肉切块更方便吃。去骨方法：从鸡腿内侧划一刀，沿骨头把肉剥下来。"
            }
          ]
        }
      }
    },
    "vegetable": {
      "name": "蔬菜",
      "icon": "🥔",
      "amount": "土豆2个(300g)+胡萝卜1根(150g)+洋葱1个(200g)",
      "options": {
        "type": {
          "label": "蔬菜搭配",
          "options": [
            {
              "id": "jkv_1",
              "name": "土豆300g+胡萝卜150g+洋葱200g",
              "desc": "经典日式咖喱三件套",
              "score": 10,
              "detail": "土豆2个（300g）+胡萝卜1根（150g）+洋葱1个（200g）。三种蔬菜是日式咖喱的经典搭配，营养均衡。"
            },
            {
              "id": "jkv_2",
              "name": "土豆300g+胡萝卜150g+洋葱200g+苹果半个(100g)",
              "desc": "加苹果更甜润",
              "score": 9,
              "detail": "加半个苹果（100g）擦泥加入，可以让咖喱更甜润。苹果的天然甜味比加糖更好。"
            },
            {
              "id": "jkv_3",
              "name": "土豆300g+洋葱200g",
              "desc": "简单版",
              "score": 7,
              "detail": "只用土豆和洋葱，简单方便。缺少胡萝卜的甜味和颜色。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "cook_onion": {
      "name": "炒洋葱",
      "description": "洋葱炒软是咖喱甜味的来源，约10分钟",
      "options": [
        {
          "id": "jk_o1",
          "name": "小火慢炒至焦糖色(10分钟)",
          "desc": "甜味最浓郁",
          "tip": "洋葱200g切丝，小火（约120度）慢炒10分钟至焦糖色。洋葱会自然焦糖化，释放甜味。这是日式咖喱甜味的关键。不要急，耐心炒。",
          "params": {
            "method": "焦糖化",
            "time": "10分钟",
            "temp": "120度"
          }
        },
        {
          "id": "jk_o2",
          "name": "中火炒至透明(3分钟)",
          "desc": "省时间",
          "tip": "中火（约160度）炒3分钟至洋葱变软透明。比焦糖化快但甜味差一些。",
          "params": {
            "method": "炒软",
            "time": "3分钟",
            "temp": "160度"
          }
        },
        {
          "id": "jk_o3",
          "name": "大火快炒(2分钟)",
          "desc": "最快",
          "tip": "大火容易糊，要不停翻炒。炒2分钟至变软即可。甜味最少。",
          "params": {
            "method": "快炒",
            "time": "2分钟",
            "temp": "200度"
          }
        }
      ]
    },
    "cook_meat": {
      "name": "炒肉",
      "description": "鸡肉炒至表面变色",
      "options": [
        {
          "id": "jk_m1",
          "name": "中火炒至变色(3分钟)",
          "desc": "嫩滑口感",
          "tip": "中火（约160度）炒3分钟至鸡肉变色。不要炒太久，后面还要炖。变色后盛出备用。",
          "params": {
            "method": "炒变色",
            "time": "3分钟",
            "temp": "160度"
          }
        },
        {
          "id": "jk_m2",
          "name": "煎至金黄(5分钟)",
          "desc": "更香",
          "tip": "煎过的鸡肉炖煮后更香。中火每面煎2-3分钟至金黄。",
          "params": {
            "method": "煎",
            "time": "5分钟",
            "temp": "160度"
          }
        }
      ]
    },
    "stew": {
      "name": "炖煮",
      "description": "加水炖煮让蔬菜软烂",
      "options": [
        {
          "id": "jk_sw1",
          "name": "加热水800ml，小火炖15分钟",
          "desc": "经典做法",
          "tip": "水要一次加够（800ml没过食材）。大火烧开后转小火炖15分钟。土豆和胡萝卜要切滚刀块，大小均匀。",
          "params": {
            "method": "炖煮",
            "time": "15分钟",
            "water": "800ml热水"
          }
        },
        {
          "id": "jk_sw2",
          "name": "加牛奶200ml炖煮",
          "desc": "更浓郁顺滑",
          "tip": "加牛奶200ml可以让咖喱更浓郁顺滑。牛奶最后再加，防止煮沸分离。",
          "params": {
            "method": "牛奶炖",
            "time": "15分钟",
            "water": "600ml水+200ml牛奶"
          }
        }
      ]
    },
    "add_curry": {
      "name": "加咖喱块",
      "description": "咖喱块要离火搅拌溶解",
      "options": [
        {
          "id": "jk_c1",
          "name": "关火后加入咖喱块搅拌溶解",
          "desc": "经典做法",
          "tip": "关火后加入咖喱块（1盒约100g），用勺子搅拌至完全溶解。关火后加更容易溶解，不会结块。",
          "params": {
            "method": "关火加",
            "amount": "咖喱块1盒(100g)"
          }
        },
        {
          "id": "jk_c2",
          "name": "小火加入咖喱粉",
          "desc": "可以调节浓稠度",
          "tip": "咖喱粉2勺（约15g）先用少许水调开再加入。咖喱粉比咖喱块更灵活，可以调节浓稠度。",
          "params": {
            "method": "咖喱粉",
            "amount": "咖喱粉2勺(15g)"
          }
        }
      ]
    },
    "finish": {
      "name": "出锅",
      "description": "浇在米饭上即可",
      "options": [
        {
          "id": "jk_f1",
          "name": "直接浇在米饭上",
          "desc": "经典吃法",
          "tip": "咖喱不要太稀，要能挂在饭上。米饭用碗盛好倒扣在盘子里，旁边浇咖喱。",
          "params": {
            "method": "浇饭"
          }
        },
        {
          "id": "jk_f2",
          "name": "加福神渍解腻",
          "desc": "日式正宗吃法",
          "tip": "福神渍是日式腌菜，酸甜开胃，可以解咖喱的腻。超市有卖现成的。",
          "params": {
            "method": "加渍菜"
          }
        }
      ]
    }
  },
