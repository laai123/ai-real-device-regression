{
  "dish": "蒜蓉粉丝蒸虾",
  "cuisine": "粤菜",
  "category": "chinese",
  "difficulty": 2,
  "cook_time": 15,
  "servings": "2-3人份",
  "calories": "约250大卡\/份",
  "ingredients": {
    "shrimp": {
      "name": "大虾",
      "icon": "🦐",
      "amount": "10只大虾（约300g）",
      "options": {
        "prep": {
          "label": "处理方式",
          "options": [
            {
              "id": "gs_1",
              "name": "开背去虾线",
              "desc": "经典做法，蒜蓉能入味",
              "score": 10,
              "detail": "从虾背第二节切开至尾部，去掉虾线。开背让蒜蓉能填入虾肉，更入味。保留虾头和虾尾，蒸出来更好看。"
            },
            {
              "id": "gs_2",
              "name": "整只用",
              "desc": "保留原味",
              "score": 7,
              "detail": "整只虾蒜蓉只能铺在表面，入味差一些。但保留了虾的完整性。"
            },
            {
              "id": "gs_3",
              "name": "去头去壳留尾",
              "desc": "方便吃",
              "score": 6,
              "detail": "去壳后蒜蓉能完全包裹虾肉，入味最好。但蒸出来卖相差。"
            }
          ]
        }
      }
    },
    "noodle": {
      "name": "粉丝",
      "icon": "🍜",
      "amount": "1把（约100g干粉丝）",
      "options": {
        "type": {
          "label": "粉丝类型",
          "options": [
            {
              "id": "gn_1",
              "name": "绿豆粉丝",
              "desc": "100g干粉丝，透明爽滑",
              "score": 10,
              "detail": "绿豆粉丝是最经典的选择，透明爽滑。100g干粉丝泡发后约300g，够2-3人。"
            },
            {
              "id": "gn_2",
              "name": "红薯粉丝",
              "desc": "100g干粉丝，口感更Q弹",
              "score": 8,
              "detail": "红薯粉丝口感更Q弹有嚼劲。颜色偏深。"
            },
            {
              "id": "gn_3",
              "name": "龙口粉丝",
              "desc": "100g干粉丝，细而入味",
              "score": 9,
              "detail": "龙口粉丝细而入味，更容易吸收蒜蓉的味道。超市有卖袋装的。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "prep": {
      "name": "准备工作",
      "description": "粉丝泡软，虾处理好，约10分钟",
      "options": [
        {
          "id": "gs_p1",
          "name": "粉丝温水泡软10分钟",
          "desc": "标准做法",
          "tip": "100g干粉丝用温水（约40度）泡10分钟至软。不要用开水泡，会泡烂。泡好后沥干水分铺在盘底。",
          "params": {
            "method": "温水泡",
            "time": "10分钟",
            "temp": "40度温水"
          }
        },
        {
          "id": "gs_p2",
          "name": "粉丝冷水泡30分钟",
          "desc": "更透",
          "tip": "冷水泡的粉丝口感更好，更透亮。但需要提前30分钟准备。",
          "params": {
            "method": "冷水泡",
            "time": "30分钟"
          }
        }
      ]
    },
    "fry_garlic": {
      "name": "炒蒜蓉",
      "description": "蒜蓉是灵魂，约3分钟",
      "options": [
        {
          "id": "gs_g1",
          "name": "小火炒蒜蓉50g至金黄(3分钟)",
          "desc": "经典做法",
          "tip": "大蒜50g（约15瓣）切末。锅里放2汤匙油（30ml），小火（约120度）炒3分钟至金黄。蒜蓉要小火慢炒，大火会糊发苦。",
          "params": {
            "method": "小火炒",
            "time": "3分钟",
            "temp": "120度",
            "ingredients": [
              "大蒜50g(约15瓣)",
              "油2汤匙(30ml)"
            ]
          }
        },
        {
          "id": "gs_g2",
          "name": "金银蒜：一半炒熟+一半生的",
          "desc": "层次更丰富",
          "tip": "大蒜50g切末，一半用油炒至金黄（2分钟），另一半保持生的。炒熟的蒜香+生蒜的辛辣，层次更丰富。",
          "params": {
            "method": "金银蒜",
            "time": "2分钟",
            "ingredients": [
              "大蒜50g(约15瓣)"
            ]
          }
        },
        {
          "id": "gs_g3",
          "name": "生蒜直接用",
          "desc": "最简单",
          "tip": "不炒直接用蒜末。蒸的时候蒜也会熟，但香味不如炒过的浓。",
          "params": {
            "method": "生蒜"
          }
        }
      ]
    },
    "assemble": {
      "name": "摆盘",
      "description": "粉丝铺底，虾摆上，浇蒜蓉",
      "options": [
        {
          "id": "gs_a1",
          "name": "粉丝铺底+虾开背朝上摆一圈+蒜蓉填入开背处",
          "desc": "经典摆盘",
          "tip": "粉丝铺在盘底，虾开背朝上摆成一圈。蒜蓉填在每只虾的开背处。蒸出来蒜蓉渗入虾肉，非常入味。",
          "params": {
            "method": "经典摆盘"
          }
        },
        {
          "id": "gs_a2",
          "name": "随意摆放",
          "desc": "家常做法",
          "tip": "味道一样，只是不太好看。虾和粉丝混在一起也可以。",
          "params": {
            "method": "随意摆"
          }
        }
      ]
    },
    "steam": {
      "name": "蒸制",
      "description": "大火蒸制，时间要精确",
      "options": [
        {
          "id": "gs_s1",
          "name": "水开后大火蒸6分钟",
          "desc": "标准时间",
          "tip": "水开后再放盘子，大火蒸6分钟。蒸太久虾会变老，粉丝会变烂。6分钟刚好。",
          "params": {
            "time": "6分钟",
            "temp": "大火"
          }
        },
        {
          "id": "gs_s2",
          "name": "蒸8分钟",
          "desc": "虾大时用",
          "tip": "大虾（15cm以上）可以多蒸2分钟。但不要超过10分钟。",
          "params": {
            "time": "8分钟",
            "temp": "大火"
          }
        }
      ]
    },
    "finish": {
      "name": "出锅",
      "description": "出锅前浇热油和生抽",
      "options": [
        {
          "id": "gs_f1",
          "name": "淋蒸鱼豉油2勺+浇热油2汤匙",
          "desc": "经典做法",
          "tip": "蒸鱼豉油2勺（30ml）淋在虾上。油2汤匙（30ml）烧到冒烟（250度）浇在蒜蓉上。会听到滋滋响，香味四溢。",
          "params": {
            "method": "淋油淋酱",
            "ingredients": [
              "蒸鱼豉油2勺(30ml)"
            ],
            "oil": "2汤匙(30ml)",
            "temp": "250度"
          }
        },
        {
          "id": "gs_f2",
          "name": "只淋生抽2勺",
          "desc": "清淡版",
          "tip": "少油更健康。生抽2勺（30ml）淋上即可。蒸鱼豉油比普通生抽味道更好。",
          "params": {
            "method": "只淋酱",
            "ingredients": [
              "生抽2勺(30ml)"
            ]
          }
        }
      ]
    }
  },
