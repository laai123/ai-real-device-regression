        "type": {
          "label": "酸菜选择",
          "options": [
            {
              "id": "scyk_1",
              "name": "四川泡酸菜",
              "desc": "200g，酸香正宗",
              "score": 10,
              "detail": "四川泡酸菜是最正宗的选择，酸度适中，香味浓郁。超市有卖袋装的，约200g。选颜色黄亮、闻起来酸香的。"
            },
            {
              "id": "scyk_2",
              "name": "东北酸菜",
              "desc": "200g，酸度较低",
