      "options": [
        {
          "id": "nmt_c1",
          "name": "黄油20g炒蘑菇至出香味(5分钟)",
          "desc": "经典做法",
          "tip": "黄油20g融化后下蘑菇片，中火（约160度）炒5分钟至出香味。蘑菇会先出水再收干，这是正常的。",
          "params": {
            "method": "黄油炒",
            "time": "5分钟",
            "temp": "160度",
            "ingredients": [
              "黄油20g"
            ]
          }
        },
        {
          "id": "nmt_c2",
          "name": "橄榄油1汤匙炒蘑菇(4分钟)",
          "desc": "更健康",
          "tip": "橄榄油1汤匙（15ml）炒蘑菇4分钟。比黄油健康，但香味稍差。",
          "params": {
            "method": "橄榄油炒",
            "time": "4分钟",
            "ingredients": [
              "橄榄油1汤匙(15ml)"
            ]
          }
        }
      ]
    },
    "soup": {
      "name": "煮汤",
      "description": "加牛奶煮汤，约10分钟",
      "options": [
        {
          "id": "nmt_s1",
          "name": "加牛奶500ml小火煮10分钟",
          "desc": "经典做法",
          "tip": "牛奶500ml小火煮10分钟。牛奶不要煮沸，否则会分离。保持微沸（约80度）即可。",
          "params": {
            "method": "牛奶煮",
            "time": "10分钟",
            "temp": "80度",
            "ingredients": [
              "牛奶500ml"
            ]
          }
        },
        {
          "id": "nmt_s2",
          "name": "加淡奶油200ml+牛奶300ml煮8分钟",
          "desc": "更浓郁",
          "tip": "淡奶油200ml+牛奶300ml。比纯牛奶更浓郁顺滑。但热量更高。",
          "params": {
            "method": "奶油煮",
            "time": "8分钟",
            "ingredients": [
              "淡奶油200ml",
              "牛奶300ml"
            ]
          }
        }
      ]
    },
    "thicken": {
      "name": "勾芡",
      "description": "让汤更浓稠",
      "options": [
        {
          "id": "nmt_t1",
          "name": "面粉15g+黄油10g炒面糊+牛奶调入",
          "desc": "经典做法",
          "tip": "面粉15g+黄油10g小火炒2分钟成面糊（Roux），再慢慢加入牛奶搅匀。这是西餐浓汤的经典做法。",
          "params": {
            "method": "面糊勾芡",
            "ingredients": [
              "面粉15g",
              "黄油10g"
            ]
          }
        },
        {
          "id": "nmt_t2",
          "name": "不勾芡",
          "desc": "清爽版",
          "tip": "不勾芡的汤更清爽，像清汤。喜欢浓稠口感的建议勾芡。",
          "params": {
            "method": "不勾芡"
          }
        }
      ]
    },
    "seasoning": {
