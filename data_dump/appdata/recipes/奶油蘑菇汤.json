        "type": {
          "label": "蘑菇选择",
          "options": [
            {
              "id": "nmt_1",
              "name": "口蘑200g",
              "desc": "经典选择，香味适中",
              "score": 10,
              "detail": "口蘑是最经典的选择，香味适中，口感嫩滑。200g约10-12个。选颜色白、表面光滑的。"
            },
            {
              "id": "nmt_2",
              "name": "香菇200g",
              "desc": "香味更浓",
              "score": 8,
              "detail": "香菇香味更浓，但口感偏韧。200g约8-10个。干香菇泡发后香味更浓。"
            },
            {
              "id": "nmt_3",
              "name": "混合蘑菇200g",
              "desc": "口感更丰富",
              "score": 9,
              "detail": "口蘑+香菇+杏鲍菇各约70g。混合蘑菇口感和香味更丰富。超市有卖混合蘑菇包。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "prep": {
      "name": "处理蘑菇",
      "description": "蘑菇要切片，约3分钟",
      "options": [
        {
          "id": "nmt_p1",
          "name": "蘑菇切5mm薄片",
          "desc": "经典切法",
          "tip": "200g蘑菇切5mm薄片，约30-40片。切好后不要洗，用厨房纸擦干净即可。洗了会吸水影响口感。",
          "params": {
            "method": "切片",
            "thickness": "5mm"
          }
        }
      ]
    },
    "cook": {
      "name": "炒蘑菇",
