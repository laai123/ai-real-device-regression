        "cut": {
          "label": "处理方式",
          "options": [
            {
              "id": "klw_1",
              "name": "两面各划2刀",
              "desc": "更入味，约1cm深",
              "score": 10,
              "detail": "鸡翅两面各划2刀，深度约1cm，不要划穿。划刀可以让可乐和调料更容易渗入内部。"
            },
            {
              "id": "klw_2",
              "name": "不处理直接用",
              "desc": "省事，但入味慢",
              "score": 7,
              "detail": "不划刀的话需要多炖5分钟才能入味。鸡翅皮会更完整好看。"
            },
            {
              "id": "klw_3",
              "name": "对半切开",
              "desc": "更快入味，但卖相差",
              "score": 6,
              "detail": "对半切开后受热面积大，10分钟就能入味。但卖相不如整只好看。"
            }
          ]
        }
      }
    },
    "cola": {
      "name": "可乐",
      "icon": "🥤",
      "amount": "330ml（1罐）",
      "options": {
        "type": {
          "label": "可乐选择",
          "options": [
            {
              "id": "cola_1",
              "name": "可口可乐330ml",
              "desc": "经典选择，甜度适中",
              "score": 10,
              "detail": "可口可乐330ml是标准用量，甜度和焦糖色都刚好。百事可乐也可以，但甜度稍高。"
            },
            {
              "id": "cola_2",
              "name": "百事可乐330ml",
              "desc": "稍甜，颜色稍浅",
              "score": 8,
              "detail": "百事可乐比可口可乐甜一点，做出来的颜色稍浅。喜欢甜口的可以用百事。"
            },
            {
              "id": "cola_3",
              "name": "零度可乐330ml",
              "desc": "无糖版，热量低",
              "score": 6,
              "detail": "零度可乐没有糖，做出来颜色浅，甜味不足。不太推荐。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "marinate": {
