      "name": "牛排",
      "icon": "🥩",
      "amount": "1块（约250g，2cm厚）",
      "options": {
        "type": {
          "label": "牛排选择",
          "options": [
            {
              "id": "np_1",
              "name": "西冷牛排",
              "desc": "250g，有嚼劲，油花适中",
              "score": 10,
              "detail": "西冷牛排（Sirloin）是最经典的牛排部位，有嚼劲，油花适中。选2cm厚、约250g的。颜色鲜红、脂肪分布均匀的最好。"
            },
            {
              "id": "np_2",
              "name": "菲力牛排",
              "desc": "200g，最嫩，脂肪少",
              "score": 9,
              "detail": "菲力（Filet）是牛里脊，最嫩但脂肪少。选2cm厚、约200g的。适合喜欢嫩肉的人。"
            },
            {
              "id": "np_3",
              "name": "肋眼牛排",
              "desc": "280g，油花丰富，香气浓郁",
              "score": 8,
              "detail": "肋眼（Ribeye）油花最丰富，香气浓郁。选2.5cm厚、约280g的。脂肪多更香。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "prep": {
      "name": "回温和调味",
      "description": "牛排要提前回温，这是煎好牛排的关键",
      "options": [
        {
          "id": "np_p1",
          "name": "提前30分钟从冰箱取出回温",
          "desc": "标准做法",
          "tip": "冷牛排下锅会导致外焦里生。提前30分钟从冰箱取出，回到室温再煎。用厨房纸擦干表面水分。",
          "params": {
            "method": "回温30分钟"
          }
        }
      ]
    },
    "seasoning": {
      "name": "调味",
      "description": "简单调味即可，好牛排不需要太多调料",
      "options": [
