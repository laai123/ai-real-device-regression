          "id": "np_s1",
          "name": "海盐1\/2茶匙+黑胡椒1\/4茶匙+橄榄油1茶匙",
          "desc": "经典调味",
          "tip": "海盐1\/2茶匙+黑胡椒1\/4茶匙（现磨更香）+橄榄油1茶匙抹匀。盐要在煎之前10分钟撒，让肉吸收。",
          "params": {
            "style": "经典",
            "ingredients": [
              "海盐1\/2茶匙",
