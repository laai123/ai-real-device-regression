            ]
          }
        },
        {
          "id": "xc_m2",
          "name": "不腌制直接炒",
          "desc": "省时间",
          "tip": "不腌制牛肉容易变老，口感差。建议至少用生抽和淀粉简单腌5分钟。",
          "params": {
            "method": "不腌",
            "time": "0"
          }
        }
      ]
    },
