  "category": "chinese",
  "difficulty": 2,
  "cook_time": 15,
  "servings": "2-3人份",
  "calories": "约380大卡\/份",
  "ingredients": {
    "beef": {
      "name": "黄牛肉",
      "icon": "🥩",
      "amount": "300g黄牛肉（里脊或腿肉）",
      "options": {
        "cut": {
          "label": "切法",
          "options": [
            {
              "id": "xc_1",
              "name": "切薄片(2mm)",
              "desc": "300g约30片，嫩滑口感",
              "score": 10,
              "detail": "2mm薄片是小炒黄牛肉的经典。逆纹切更嫩。切好后用蛋清+淀粉上浆，口感更滑嫩。"
            },
            {
              "id": "xc_2",
              "name": "切丝(3mm宽)",
              "desc": "300g约150根，快速入味",
              "score": 7,
              "detail": "3mm宽的牛肉丝受热快，更容易入味。但炒的时候容易散。"
            }
          ]
        }
      }
    },
    "vegetable": {
      "name": "配菜",
      "icon": "🌶️",
      "amount": "青椒3个(150g)+小米辣5个(20g)+蒜苗2根(60g)",
      "options": {
        "type": {
          "label": "配菜选择",
          "options": [
            {
              "id": "xcv_1",
              "name": "青椒150g+小米辣20g+蒜苗60g",
              "desc": "经典搭配，香辣够味",
              "score": 10,
              "detail": "青椒3个切块150g+小米辣5个切段20g+蒜苗2根切段60g。三种辣椒搭配，辣度层次丰富。"
            },
            {
              "id": "xcv_2",
              "name": "青椒150g+红椒50g",
              "desc": "颜色更好",
              "score": 8,
              "detail": "青椒150g+红椒50g。红椒增加颜色，但辣度比青椒高。"
            },
            {
              "id": "xcv_3",
              "name": "只用青椒200g",
              "desc": "简单版",
              "score": 7,
              "detail": "只用青椒200g。简单方便，但缺少辣味层次。"
            }
          ]
        }
      }
    }
  },
  "cooking_flow": {
    "marinate": {
